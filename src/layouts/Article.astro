---
// Shared frame for posts, projects and stand-alone pages.
import Garden from '../components/Garden.astro';
import { formatDate, isoDate, tagSlug } from '../lib/content';
import Base from './Base.astro';

interface Link {
  href: string;
  title: string;
}

interface Props {
  title: string;
  description?: string;
  /** Seeds this page's garden; use something stable like the entry id. */
  seed: string;
  date?: Date;
  updated?: Date;
  readingTime?: string;
  tags?: string[];
  draft?: boolean;
  newer?: Link;
  older?: Link;
}

const { title, description, seed, date, updated, readingTime, tags = [], draft, newer, older } = Astro.props;
const hasMeta = date || readingTime || tags.length || Astro.slots.has('meta');
---

<Base title={title} description={description}>
  <Garden seed={seed} />
  <article class="layout article">
    {
      hasMeta && (
        <div class="rail article-meta">
          {date && (
            <p>
              <time datetime={isoDate(date)}>{formatDate(date)}</time>
            </p>
          )}
          {updated && (
            <p>
              Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
            </p>
          )}
          {readingTime && <p>{readingTime}</p>}
          <slot name="meta" />
          {tags.length > 0 && (
            <ul aria-label="Tags">
              {tags.map((tag) => (
                <li>
                  <a href={`/tags/${tagSlug(tag)}/`}>{tag}</a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }
    <header>
      <h1 class="page-title">
        {title}
        {draft && <span class="draft-badge">draft</span>}
      </h1>
      {description && <p class="lede">{description}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
    {
      (newer || older) && (
        <footer class="article-footer">
          <nav aria-label="More posts">
            {older ? (
              <a href={older.href} rel="prev">
                <span>Older</span>
                {older.title}
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a href={newer.href} rel="next">
                <span>Newer</span>
                {newer.title}
              </a>
            )}
          </nav>
        </footer>
      )
    }
  </article>
</Base>
