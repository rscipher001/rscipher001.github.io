---
// Stand-alone pages from src/content/pages/, e.g. about.md -> /about/
import { render } from 'astro:content';
import Article from '../layouts/Article.astro';
import { getPages } from '../lib/content';

export async function getStaticPaths() {
  return (await getPages()).map((page) => ({ params: { page: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Article title={page.data.title} description={page.data.description} seed={page.id} draft={page.data.draft}>
  <Content />
</Article>
